\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Strong scaling, 2D OpenMP (E01)}{4}{subsection.8.1}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Cache-regime / size sweep (E02)}{4}{subsection.8.2}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 2D OMP strong-scaling at $N{=}4098$, $B{=}128$, $T{=}8$, log- log axes. Temporal hits 91\tmspace  +\thinmuskip {.1667em}\% of perfect 8$\times $ scaling (7.31$\times $); baseline reaches only 56\tmspace  +\thinmuskip {.1667em}\% (4.49$\times $). The temp-vs-base ratio shrinks monotonically from 0.94$\times $ at one thread to 0.58$\times $ at 8 threads -- the canonical traffic-reduction signature.\relax }}{5}{figure.caption.1}}
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:e01}{{1}{5}{2D OMP strong-scaling at $N{=}4098$, $B{=}128$, $T{=}8$, log- log axes. Temporal hits 91\,\% of perfect 8$\times $ scaling (7.31$\times $); baseline reaches only 56\,\% (4.49$\times $). The temp-vs-base ratio shrinks monotonically from 0.94$\times $ at one thread to 0.58$\times $ at 8 threads -- the canonical traffic-reduction signature.\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Size sweep at 8 threads. L3 per socket = 38.4\tmspace  +\thinmuskip {.1667em}MB. The baseline jumps from CPE 0.464 at $N{=}1024$ to 0.667 at $N{=}2048$ -- the L3$\to $DRAM crossover. Temporal stays at $\sim $0.35 across $N{=}1024$\tmspace  +\thinmuskip {.1667em}--$\tmspace  +\thinmuskip {.1667em}4098$ and \textbf  {wins 1.93$\times $ at $N{=}2048$}.\relax }}{5}{figure.caption.2}}
\newlabel{fig:e02}{{2}{5}{Size sweep at 8 threads. L3 per socket = 38.4\,MB. The baseline jumps from CPE 0.464 at $N{=}1024$ to 0.667 at $N{=}2048$ -- the L3$\to $DRAM crossover. Temporal stays at $\sim $0.35 across $N{=}1024$\,--$\,4098$ and \textbf {wins 1.93$\times $ at $N{=}2048$}.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Spatial block size $B$ (E03)}{5}{subsection.8.3}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Temporal depth $T$ (E04)}{5}{subsection.8.4}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces B sweep at $N{=}2048$, $T{=}4$, 8 threads. Baseline (grey) is flat -- $B$ has no effect on the baseline kernel. Temporal has a wide plateau across $B \in [24, 256]$, then \emph  {falls off a cliff} at $B{\geq }384$. The cliff is the L2-fit threshold (red dashed): $2(B{+}8)^2 \cdot 8\tmspace  +\thinmuskip {.1667em}\text  {B} \leq 1.5$\tmspace  +\thinmuskip {.1667em}MB $\Rightarrow B \leq 297$.\relax }}{6}{figure.caption.3}}
\newlabel{fig:e03}{{3}{6}{B sweep at $N{=}2048$, $T{=}4$, 8 threads. Baseline (grey) is flat -- $B$ has no effect on the baseline kernel. Temporal has a wide plateau across $B \in [24, 256]$, then \emph {falls off a cliff} at $B{\geq }384$. The cliff is the L2-fit threshold (red dashed): $2(B{+}8)^2 \cdot 8\,\text {B} \leq 1.5$\,MB $\Rightarrow B \leq 297$.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Unimodal $T$-curve at $N{=}2048$, $B{=}128$, 8 threads. Left axis: CPE. Right axis (red dashed): halo-overhead percentage $((B{+}2T)^2/B^2 - 1)\cdot 100$. Minimum at $T{=}8$ with CPE 0.332 -- \textbf  {the project's best CPU CPE}. $T{=}1$ loses to overhead (memcpy + scratch alloc with no DRAM reuse); $T{=}32$ loses to 125\tmspace  +\thinmuskip {.1667em}\% redundant halo work.\relax }}{6}{figure.caption.4}}
\newlabel{fig:e04}{{4}{6}{Unimodal $T$-curve at $N{=}2048$, $B{=}128$, 8 threads. Left axis: CPE. Right axis (red dashed): halo-overhead percentage $((B{+}2T)^2/B^2 - 1)\cdot 100$. Minimum at $T{=}8$ with CPE 0.332 -- \textbf {the project's best CPU CPE}. $T{=}1$ loses to overhead (memcpy + scratch alloc with no DRAM reuse); $T{=}32$ loses to 125\,\% redundant halo work.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.5}Pthreads decomposition $\times $ scheduling (E05)}{6}{subsection.8.5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.6}3D OMP partitioning (E06)}{6}{subsection.8.6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.7}Pthread spawn overhead -- Lab-6-Part-1b (E07)}{6}{subsection.8.7}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Six lines: 3 modes $\times $ 2 schedules at $N{=}2048$, iters$=64$. Strip-persistent (blue solid) at 8 threads: \textbf  {CPE 0.255, 7.89$\times $ linear scaling} -- within 1.4\tmspace  +\thinmuskip {.1667em}\% of perfect 8$\times $. Interleaved bottoms out at 2.67$\times $ (cache-line ping-pong on adjacent rows). Spawn-vs-persistent slowdown is largest for strip (1.54$\times $) because strip's per-sweep work is smallest.\relax }}{7}{figure.caption.5}}
\newlabel{fig:e05}{{5}{7}{Six lines: 3 modes $\times $ 2 schedules at $N{=}2048$, iters$=64$. Strip-persistent (blue solid) at 8 threads: \textbf {CPE 0.255, 7.89$\times $ linear scaling} -- within 1.4\,\% of perfect 8$\times $. Interleaved bottoms out at 2.67$\times $ (cache-line ping-pong on adjacent rows). Spawn-vs-persistent slowdown is largest for strip (1.54$\times $) because strip's per-sweep work is smallest.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 4-panel: $N \in \{66, 130, 194, 258\}$. Slab (blue) and pencil (green) tie at all $N$ at 8 threads; cube (red) loses 1.3--1.7$\times $ to its 18.75\tmspace  +\thinmuskip {.1667em}\% halo overhead. Best 3D CPU CPE = 0.359 at slab, $N{=}130$, 8 threads.\relax }}{7}{figure.caption.6}}
\newlabel{fig:e06}{{6}{7}{4-panel: $N \in \{66, 130, 194, 258\}$. Slab (blue) and pencil (green) tie at all $N$ at 8 threads; cube (red) loses 1.3--1.7$\times $ to its 18.75\,\% halo overhead. Best 3D CPU CPE = 0.359 at slab, $N{=}130$, 8 threads.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.8}Omega U-curve, red-black GS-SOR (E08)}{7}{subsection.8.8}}
\newlabel{sec:omega}{{8.8}{7}{Omega U-curve, red-black GS-SOR (E08)}{subsection.8.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Linear-fit $\text  {time} = a + b \cdot \text  {iters}$. Persistent slope: 81\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep (compute work only). Spawn slope: 235\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep. \textbf  {Per-sweep \texttt  {pthread\_create+join} overhead = 153\tmspace  +\thinmuskip {.1667em}$\mu $s} -- larger than the 81\tmspace  +\thinmuskip {.1667em}$\mu $s of actual compute work. Spawning per sweep is a 1.89$\times $ tax on the kernel.\relax }}{8}{figure.caption.7}}
\newlabel{fig:e07}{{7}{8}{Linear-fit $\text {time} = a + b \cdot \text {iters}$. Persistent slope: 81\,$\mu $s/sweep (compute work only). Spawn slope: 235\,$\mu $s/sweep. \textbf {Per-sweep \texttt {pthread\_create+join} overhead = 153\,$\mu $s} -- larger than the 81\,$\mu $s of actual compute work. Spawning per sweep is a 1.89$\times $ tax on the kernel.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The classical Lab-5 figure. 150 $\omega $ values in [0.50, 1.99] at $N{=}128$, log-y. Theoretical $\omega _{\text  {opt}} = 2/(1{+}\qopname  \relax o{sin}(\pi /(N{-}1))) = 1.9517$ (red dashed) matches the empirical minimum at $\omega {=}1.95$ (green dotted) to \textbf  {0.1\tmspace  +\thinmuskip {.1667em}\%}. 254 iters at $\omega _{\text  {opt}}$ vs 3,434 at $\omega {=}1$ (Gauss--Seidel) -- a \textbf  {13.5$\times $ fewer-iteration win} from algorithmic tuning alone.\relax }}{8}{figure.caption.8}}
\newlabel{fig:e08}{{8}{8}{The classical Lab-5 figure. 150 $\omega $ values in [0.50, 1.99] at $N{=}128$, log-y. Theoretical $\omega _{\text {opt}} = 2/(1{+}\sin (\pi /(N{-}1))) = 1.9517$ (red dashed) matches the empirical minimum at $\omega {=}1.95$ (green dotted) to \textbf {0.1\,\%}. 254 iters at $\omega _{\text {opt}}$ vs 3,434 at $\omega {=}1$ (Gauss--Seidel) -- a \textbf {13.5$\times $ fewer-iteration win} from algorithmic tuning alone.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 21 (TILE, HALO) combos at $N{=}2048$, iters$=96$ on L40S. Best at $(\text  {TILE}{=}24, \text  {HALO}{=}4)$ with CPE 0.0088 -- \textbf  {1.56$\times $ over the per-launch baseline kernel}. HALO=4 wins for all TILE$\geq $16; TILE=8 is dead (only 64 threads/block). Empirical pattern: \textbf  {keep HALO $\leq $ INTER/4}.\relax }}{9}{figure.caption.9}}
\newlabel{fig:e09}{{9}{9}{21 (TILE, HALO) combos at $N{=}2048$, iters$=96$ on L40S. Best at $(\text {TILE}{=}24, \text {HALO}{=}4)$ with CPE 0.0088 -- \textbf {1.56$\times $ over the per-launch baseline kernel}. HALO=4 wins for all TILE$\geq $16; TILE=8 is dead (only 64 threads/block). Empirical pattern: \textbf {keep HALO $\leq $ INTER/4}.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Both kernels validate against the CPU reference at $\sim $1.4$\times 10^{-7}$ relative error (FP32 round-off over 96 iters). Best 2D GPU CPE = \textbf  {0.0089 at $N{=}3074$}; both kernels degrade at $N{=}4098$ when the working set exceeds the L40S L2 ($\sim $96\tmspace  +\thinmuskip {.1667em}MB) -- the GPU equivalent of the CPU L3 cliff in E02. The 3D temporal regression is a known halo-overhead issue ($7\times $ redundant work at TILE=8/HALO=2); the 2.5D-streaming variant is the standard fix.\relax }}{9}{figure.caption.10}}
\newlabel{fig:e10}{{10}{9}{Both kernels validate against the CPU reference at $\sim $1.4$\times 10^{-7}$ relative error (FP32 round-off over 96 iters). Best 2D GPU CPE = \textbf {0.0089 at $N{=}3074$}; both kernels degrade at $N{=}4098$ when the working set exceeds the L40S L2 ($\sim $96\,MB) -- the GPU equivalent of the CPU L3 cliff in E02. The 3D temporal regression is a known halo-overhead issue ($7\times $ redundant work at TILE=8/HALO=2); the 2.5D-streaming variant is the standard fix.\relax }{figure.caption.10}{}}
