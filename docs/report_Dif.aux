\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.5.1}Discussion of CPE}{8}{subsubsection.2.5.1}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 2D OMP size sweep at 8 threads, $B{=}128$, $T{=}8$, iters$=64$. Median of 3 reps; shaded band is the min/max envelope. The L3$\to $DRAM crossover lands between $N{=}1024$ and $N{=}2048$: baseline CPE \emph  {rises} from 0.464 to 0.667 as the working set exceeds 38\tmspace  +\thinmuskip {.1667em}MB (one socket's L3). Temporal stays at $\sim $0.35 across $N{=}1024$\tmspace  +\thinmuskip {.1667em}--$\tmspace  +\thinmuskip {.1667em}4098$. It's L2-resident on its scratch. And wins 1.93$\times $ at $N{=}2048$. Below L3 (the two leftmost points) temporal \emph  {loses}: per-tile scratch malloc + redundant halo work cancel the savings on a working set the baseline already had in cache.\relax }}{8}{figure.caption.13}}
\newlabel{fig:size-sweep}{{4}{8}{2D OMP size sweep at 8 threads, $B{=}128$, $T{=}8$, iters$=64$. Median of 3 reps; shaded band is the min/max envelope. The L3$\to $DRAM crossover lands between $N{=}1024$ and $N{=}2048$: baseline CPE \emph {rises} from 0.464 to 0.667 as the working set exceeds 38\,MB (one socket's L3). Temporal stays at $\sim $0.35 across $N{=}1024$\,--$\,4098$. It's L2-resident on its scratch. And wins 1.93$\times $ at $N{=}2048$. Below L3 (the two leftmost points) temporal \emph {loses}: per-tile scratch malloc + redundant halo work cancel the savings on a working set the baseline already had in cache.\relax }{figure.caption.13}{}}
\@writefile{toc}{\contentsline {paragraph}{Block size sweep.}{8}{section*.14}}
\@writefile{toc}{\contentsline {paragraph}{Halo / T sweep.}{8}{section*.16}}
\@writefile{toc}{\contentsline {paragraph}{Strong scaling and decomposition.}{8}{section*.19}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Spatial block-size sweep at $N{=}2048$, $T{=}4$, 8 threads. Baseline is flat (grey). $B$ has no effect on the baseline kernel, which never sees a tile. Temporal has a wide plateau across $B{\in } [24, 256]$ at CPE $\sim $0.39, then \emph  {falls off a cliff} at $B{\geq }384$. Red dashed line is the L2-fit threshold: $2(B{+}8)^2{\cdot }4\tmspace  +\thinmuskip {.1667em}\text  {B} \leq 1.5$\tmspace  +\thinmuskip {.1667em}MB $\Rightarrow B \leq 297$. Beyond that, the per-thread scratch doesn't fit L2 and we pay L3 misses on our \emph  {own} scratch. Defeating the entire purpose.\relax }}{9}{figure.caption.15}}
\newlabel{fig:block-sweep}{{5}{9}{Spatial block-size sweep at $N{=}2048$, $T{=}4$, 8 threads. Baseline is flat (grey). $B$ has no effect on the baseline kernel, which never sees a tile. Temporal has a wide plateau across $B{\in } [24, 256]$ at CPE $\sim $0.39, then \emph {falls off a cliff} at $B{\geq }384$. Red dashed line is the L2-fit threshold: $2(B{+}8)^2{\cdot }4\,\text {B} \leq 1.5$\,MB $\Rightarrow B \leq 297$. Beyond that, the per-thread scratch doesn't fit L2 and we pay L3 misses on our \emph {own} scratch. Defeating the entire purpose.\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Temporal depth $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters$=96$. Left axis: CPE (lower = faster). Right axis (red dashed): redundant halo work as a percentage, $((B{+}2T)^2/B^2 - 1){\cdot }100$. The two axes encode the project's central tradeoff: DRAM savings grow linearly in $T$, redundant halo work grows quadratically, and the unimodal product peaks at $T{=}8$ with CPE $0.332$. The best CPU CPE we measured anywhere. $T{=}1$ loses to per-tile-malloc + memcpy overhead with no DRAM reuse; $T{=}32$ has 125\% halo overhead and gives \emph  {everything} back.\relax }}{9}{figure.caption.17}}
\newlabel{fig:t-sweep}{{6}{9}{Temporal depth $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters$=96$. Left axis: CPE (lower = faster). Right axis (red dashed): redundant halo work as a percentage, $((B{+}2T)^2/B^2 - 1){\cdot }100$. The two axes encode the project's central tradeoff: DRAM savings grow linearly in $T$, redundant halo work grows quadratically, and the unimodal product peaks at $T{=}8$ with CPE $0.332$. The best CPU CPE we measured anywhere. $T{=}1$ loses to per-tile-malloc + memcpy overhead with no DRAM reuse; $T{=}32$ has 125\% halo overhead and gives \emph {everything} back.\relax }{figure.caption.17}{}}
\@writefile{toc}{\contentsline {paragraph}{Pthread spawn-overhead.}{9}{section*.21}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Halo / $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters$=96$. Best temp/base ratio at $T{=}8$ (0.75$\times $. Temporal is 25\% faster than baseline at the same iter count). At $T{=}1$ temporal is \emph  {worse}. It pays the per-tile-malloc + memcpy overhead with no DRAM-reuse benefit. At $T{=}32$ the halo overhead swallows the win. This is the central plot for the talk.\relax }}{10}{table.caption.18}}
\newlabel{tab:t-sweep}{{2}{10}{Halo / $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters$=96$. Best temp/base ratio at $T{=}8$ (0.75$\times $. Temporal is 25\% faster than baseline at the same iter count). At $T{=}1$ temporal is \emph {worse}. It pays the per-tile-malloc + memcpy overhead with no DRAM-reuse benefit. At $T{=}32$ the halo overhead swallows the win. This is the central plot for the talk.\relax }{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 6 lines = 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Within 1.4\% of perfect 8$\times $. Interleaved bottoms out at 2.67$\times $; the cause is false sharing on adjacent rows, since two threads ping-pong cache lines they share.\relax }}{10}{figure.caption.20}}
\newlabel{fig:strong-scaling}{{7}{10}{Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 6 lines = 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Within 1.4\% of perfect 8$\times $. Interleaved bottoms out at 2.67$\times $; the cause is false sharing on adjacent rows, since two threads ping-pong cache lines they share.\relax }{figure.caption.20}{}}
\newlabel{fig:decomp}{{7}{10}{Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 6 lines = 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Within 1.4\% of perfect 8$\times $. Interleaved bottoms out at 2.67$\times $; the cause is false sharing on adjacent rows, since two threads ping-pong cache lines they share.\relax }{figure.caption.20}{}}
\@writefile{toc}{\contentsline {paragraph}{The OMP-vs-pthreads surprise.}{10}{section*.23}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Wall-time vs iters at $N{=}512$, 4 threads, mode=strip. Linear-fit \texttt  {time = a + b$\cdot $iters} for both schedules. Persistent slope: 81\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep. The actual compute work. Spawn slope: 235\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep. The slope difference of 153\tmspace  +\thinmuskip {.1667em}$\mu $s is the per-sweep \texttt  {pthread\_create}$+$\texttt  {join} overhead. \textbf  {It's larger than the compute work itself.} Spawning fresh threads on every sweep is a 1.89$\times $ tax on the kernel.\relax }}{11}{figure.caption.22}}
\newlabel{fig:spawn}{{8}{11}{Wall-time vs iters at $N{=}512$, 4 threads, mode=strip. Linear-fit \texttt {time = a + b$\cdot $iters} for both schedules. Persistent slope: 81\,$\mu $s/sweep. The actual compute work. Spawn slope: 235\,$\mu $s/sweep. The slope difference of 153\,$\mu $s is the per-sweep \texttt {pthread\_create}$+$\texttt {join} overhead. \textbf {It's larger than the compute work itself.} Spawning fresh threads on every sweep is a 1.89$\times $ tax on the kernel.\relax }{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.5.2}Discussion of Iteration Number and Error}{11}{subsubsection.2.5.2}}
\newlabel{sec:omega}{{2.5.2}{11}{Discussion of Iteration Number and Error}{subsubsection.2.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Red-black GS-SOR omega U-curve at $N{=}128$, TOL$=10^{-5}$. 150 $\omega $ values in [0.50, 1.99] in 0.01 steps. Theory $\omega _{\text  {opt}} = 2/(1+\qopname  \relax o{sin}(\pi /(N{-}1))) = \mathbf  {1.9517}$ (red dashed) matches empirical minimum at $\omega = \mathbf  {1.95}$ (green dotted) to \textbf  {0.1\%}. 254 iters at $\omega _{\text  {opt}}$ vs 3,434 at $\omega {=}1$ (Gauss-Seidel). A \textbf  {13.5$\times $ fewer-iteration win} from algorithmic tuning alone.\relax }}{11}{figure.caption.24}}
\newlabel{fig:omega-ucurve}{{9}{11}{Red-black GS-SOR omega U-curve at $N{=}128$, TOL$=10^{-5}$. 150 $\omega $ values in [0.50, 1.99] in 0.01 steps. Theory $\omega _{\text {opt}} = 2/(1+\sin (\pi /(N{-}1))) = \mathbf {1.9517}$ (red dashed) matches empirical minimum at $\omega = \mathbf {1.95}$ (green dotted) to \textbf {0.1\%}. 254 iters at $\omega _{\text {opt}}$ vs 3,434 at $\omega {=}1$ (Gauss-Seidel). A \textbf {13.5$\times $ fewer-iteration win} from algorithmic tuning alone.\relax }{figure.caption.24}{}}
