\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Memory allocation and transfer}{12}{subsection.3.1}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces GPU memory layout at $N{=}2048$, FP32. The dominant transfer cost is the initial 16\tmspace  +\thinmuskip {.1667em}MB host-to-device copy of \texttt  {d\_src}. At PCIe Gen4's $\sim $25\tmspace  +\thinmuskip {.1667em}GB/s that's $\sim $0.6\tmspace  +\thinmuskip {.1667em}ms or $\sim $2$\times 10^6$ cycles at 3.5\tmspace  +\thinmuskip {.1667em}GHz. About the same wall time as a single GPU \emph  {baseline} kernel launch over 2048$\times $2048 ($\sim $2.7\tmspace  +\thinmuskip {.1667em}ms). After that, the iteration loop is fully on-device.\relax }}{12}{table.caption.26}}
\newlabel{tab:gpu-mem}{{3}{12}{GPU memory layout at $N{=}2048$, FP32. The dominant transfer cost is the initial 16\,MB host-to-device copy of \texttt {d\_src}. At PCIe Gen4's $\sim $25\,GB/s that's $\sim $0.6\,ms or $\sim $2$\times 10^6$ cycles at 3.5\,GHz. About the same wall time as a single GPU \emph {baseline} kernel launch over 2048$\times $2048 ($\sim $2.7\,ms). After that, the iteration loop is fully on-device.\relax }{table.caption.26}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The parallelised hot loop on the GPU}{13}{subsection.3.2}}
\@writefile{toc}{\contentsline {paragraph}{Vocabulary watch.}{13}{section*.27}}
\@writefile{toc}{\contentsline {paragraph}{Tuning sweep.}{14}{section*.28}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces GPU 2D temporal kernel (TILE, HALO) sweep at $N{=}2048$, iters$=96$. 21 valid combos $\times $ 3 reps. Best at $(\textsc  {tile}{=}24,\tmspace  +\thinmuskip {.1667em} \textsc  {halo}{=}4)$ with CPE 0.0088 -- \textbf  {1.56$\times $ over the per-launch baseline kernel} (CPE 0.0137). TILE=8 is dead. Only 64 threads/block (2 warps) isn't enough to hide DRAM latency. HALO too big collapses too: the empirical pattern is \textbf  {HALO $\leq $ INTER/4}.\relax }}{14}{figure.caption.29}}
\newlabel{fig:gpu-tile-halo}{{10}{14}{GPU 2D temporal kernel (TILE, HALO) sweep at $N{=}2048$, iters$=96$. 21 valid combos $\times $ 3 reps. Best at $(\textsc {tile}{=}24,\, \textsc {halo}{=}4)$ with CPE 0.0088 -- \textbf {1.56$\times $ over the per-launch baseline kernel} (CPE 0.0137). TILE=8 is dead. Only 64 threads/block (2 warps) isn't enough to hide DRAM latency. HALO too big collapses too: the empirical pattern is \textbf {HALO $\leq $ INTER/4}.\relax }{figure.caption.29}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Partitioning the rest of the algorithm}{14}{subsection.3.3}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Running it end-to-end}{14}{subsection.3.4}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 2D GPU baseline vs temporal across $N$, iters$=96$, defaults TILE=32, HALO=4. Median of 3 reps; shaded band is min/max envelope. At small $N$ the baseline is launch-overhead-dominated (96 launches $\times $ $\sim $30\tmspace  +\thinmuskip {.1667em}$\mu $s ${\approx }$ 3\tmspace  +\thinmuskip {.1667em}ms is most of its wall time at $N{=}258$); the 17$\times $ ``speedup'' there is mostly launch-count reduction (96$\to $24), not bandwidth. At $N{\geq }1024$ the steady-state speedup is a more honest \textbf  {1.5--3$\times $}. At $N{=}4098$ both kernels degrade because two FP32 buffers (128\tmspace  +\thinmuskip {.1667em}MB) exceed the L40S's $\sim $96\tmspace  +\thinmuskip {.1667em}MB L2. The GPU equivalent of the CPU L3 cliff in Figure\nobreakspace  {}\ref  {fig:size-sweep}, two orders of magnitude larger. Best 2D GPU CPE = \textbf  {0.0089} at $N{=}3074$.\relax }}{15}{figure.caption.30}}
\newlabel{fig:gpu-n}{{11}{15}{2D GPU baseline vs temporal across $N$, iters$=96$, defaults TILE=32, HALO=4. Median of 3 reps; shaded band is min/max envelope. At small $N$ the baseline is launch-overhead-dominated (96 launches $\times $ $\sim $30\,$\mu $s ${\approx }$ 3\,ms is most of its wall time at $N{=}258$); the 17$\times $ ``speedup'' there is mostly launch-count reduction (96$\to $24), not bandwidth. At $N{\geq }1024$ the steady-state speedup is a more honest \textbf {1.5--3$\times $}. At $N{=}4098$ both kernels degrade because two FP32 buffers (128\,MB) exceed the L40S's $\sim $96\,MB L2. The GPU equivalent of the CPU L3 cliff in Figure~\ref {fig:size-sweep}, two orders of magnitude larger. Best 2D GPU CPE = \textbf {0.0089} at $N{=}3074$.\relax }{figure.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces 2D GPU N-sweep, iters$=96$. CPE values reported at CPNS$=2.0$ (lab convention), so the absolute scale is approximate on this 2.5--4.1\tmspace  +\thinmuskip {.1667em}GHz Ada part, but the \emph  {ratios} between runs are exact.\relax }}{15}{table.caption.31}}
\newlabel{tab:gpu-n}{{4}{15}{2D GPU N-sweep, iters$=96$. CPE values reported at CPNS$=2.0$ (lab convention), so the absolute scale is approximate on this 2.5--4.1\,GHz Ada part, but the \emph {ratios} between runs are exact.\relax }{table.caption.31}{}}
