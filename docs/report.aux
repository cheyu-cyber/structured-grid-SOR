\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Temporal depth $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters=96. Left axis: CPE. Right axis: redundant halo work, $((B{+}2T)^2/B^2 - 1){\cdot }100$. Optimum at $T{=}8$, CPE 0.332.\relax }}{7}{figure.caption.15}}
\newlabel{fig:t-sweep}{{6}{7}{Temporal depth $T$ sweep at $N{=}2048$, $B{=}128$, 8 threads, iters=96. Left axis: CPE. Right axis: redundant halo work, $((B{+}2T)^2/B^2 - 1){\cdot }100$. Optimum at $T{=}8$, CPE 0.332.\relax }{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Halo/$T$ sweep. Best at $T{=}8$ (25\% faster than baseline); $T{=}1$ pays scratch overhead with no DRAM-reuse benefit; $T{=}32$ is swallowed by halo overhead.\relax }}{7}{table.caption.16}}
\newlabel{tab:t-sweep}{{1}{7}{Halo/$T$ sweep. Best at $T{=}8$ (25\% faster than baseline); $T{=}1$ pays scratch overhead with no DRAM-reuse benefit; $T{=}32$ is swallowed by halo overhead.\relax }{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Interleaved bottoms out at 2.67$\times $ from false sharing on adjacent rows.\relax }}{7}{figure.caption.18}}
\newlabel{fig:strong-scaling}{{7}{7}{Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Interleaved bottoms out at 2.67$\times $ from false sharing on adjacent rows.\relax }{figure.caption.18}{}}
\newlabel{fig:decomp}{{7}{7}{Left: strong scaling at $N{=}4098$, $B{=}128$, $T{=}8$. Right: 3 modes (strip / interleaved / 2D-block) $\times $ 2 schedules (persistent / spawn). Strip-persistent at 8 threads: CPE 0.255, 7.89$\times $ scaling. Interleaved bottoms out at 2.67$\times $ from false sharing on adjacent rows.\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Wall-time vs iters at $N{=}512$, 4 threads, mode=strip. Persistent slope: 81\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep (compute work). Spawn slope: 235\tmspace  +\thinmuskip {.1667em}$\mu $s/sweep. Slope difference 153\tmspace  +\thinmuskip {.1667em}$\mu $s is the per-sweep \texttt  {pthread\_create}+\texttt  {join} overhead, larger than the compute work itself.\relax }}{8}{figure.caption.20}}
\newlabel{fig:spawn}{{8}{8}{Wall-time vs iters at $N{=}512$, 4 threads, mode=strip. Persistent slope: 81\,$\mu $s/sweep (compute work). Spawn slope: 235\,$\mu $s/sweep. Slope difference 153\,$\mu $s is the per-sweep \texttt {pthread\_create}+\texttt {join} overhead, larger than the compute work itself.\relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Red-black GS-SOR omega U-curve at $N{=}128$, TOL=$10^{-5}$. Theory $\omega _{\text  {opt}} = 1.9517$ (red dashed) matches empirical minimum at $\omega = 1.95$ (green dotted) to 0.1\%. 254 iters at $\omega _{\text  {opt}}$ vs 3{,}434 at $\omega {=}1$ (Gauss-Seidel) is a 13.5$\times $ fewer-iteration win.\relax }}{8}{figure.caption.22}}
\newlabel{fig:omega-ucurve}{{9}{8}{Red-black GS-SOR omega U-curve at $N{=}128$, TOL=$10^{-5}$. Theory $\omega _{\text {opt}} = 1.9517$ (red dashed) matches empirical minimum at $\omega = 1.95$ (green dotted) to 0.1\%. 254 iters at $\omega _{\text {opt}}$ vs 3{,}434 at $\omega {=}1$ (Gauss-Seidel) is a 13.5$\times $ fewer-iteration win.\relax }{figure.caption.22}{}}
